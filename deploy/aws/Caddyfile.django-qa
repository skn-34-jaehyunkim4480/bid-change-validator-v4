{$SITE_DOMAIN} {
    encode gzip

    # Opt-in route: unchanged FastAPI traffic is handled by the next block.
    handle /api/v1/django-qa/* {
        reverse_proxy django-qa:8001
    }

    # Django 템플릿으로 그리는 공고 조회 화면(읽기 전용).
    handle /django/* {
        reverse_proxy django-qa:8001
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}